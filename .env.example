DATABASE_URL="file:./dev.db"

# gemini (default) | heuristic (offline deterministic extraction for local demo)
AI_PROVIDER="gemini"
AI_API_KEY=""
AI_MODEL="gemini-2.0-flash"

PAYPAL_CLIENT_ID=""
PAYPAL_CLIENT_SECRET=""
PAYPAL_BASE_URL="https://api-m.sandbox.paypal.com"
PAYPAL_WEBHOOK_ID=""
PAYPAL_CURRENCY="PHP"
PAYPAL_BRAND_NAME="KINTA"
PAYPAL_RETURN_URL="http://localhost:3000/dashboard"
PAYPAL_CANCEL_URL="http://localhost:3000/dashboard"
# When credentials are empty, PayPal APIs run in mock mode automatically.
# Set PAYPAL_MOCK="true" to force mock even if credentials exist.
# For real Sandbox JS SDK Buttons: credentials + PAYPAL_MOCK="false"
PAYPAL_MOCK="true"
NEXT_PUBLIC_PAYPAL_CLIENT_ID=""
