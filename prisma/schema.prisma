// KINTA — Prisma Schema
// Monetary values are stored in integer minor units (centavos / cents).
// PayPal fields are reserved for Developer 2 — no PayPal API calls here.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ─────────────────────────────────────────────
// Enums (SQLite stores these as strings)
// ─────────────────────────────────────────────

enum ProjectStatus {
  DRAFT
  ACTIVE
  DISRUPTED
  RECOVERING
  ARCHIVED
  COMPLETED
}

enum SupplierCategory {
  VENUE
  CATERING
  PHOTOGRAPHY
  EQUIPMENT
  TRANSPORT
  ENTERTAINMENT
  OTHER
}

enum PaymentStatus {
  UNPAID
  PARTIAL
  PAID
  REFUNDED
  PARTIALLY_REFUNDED
}

enum CommitmentStatus {
  DRAFT
  CONFIRMED
  AT_RISK
  CANCELLED
  FULFILLED
  RENEGOTIATED
}

enum DependencyType {
  COMMITMENT
  EVENT_DATE
  LOCATION
  VENUE_ACCESS
  SERVICE_ARRANGEMENT
}

enum ExpenseCategory {
  SUPPLIER_PAYMENT
  ADDITIONAL_COST
  PENALTY
  REFUND_OUT
  OTHER
}

enum CustomerPaymentStatus {
  CREATED
  APPROVED
  CAPTURED
  VOIDED
  REFUNDED
  PARTIALLY_REFUNDED
  FAILED
}

enum RefundStatus {
  PENDING
  COMPLETED
  FAILED
}

enum DisruptionStatus {
  REPORTED
  ANALYZING
  ANALYZED
  PLANNING
  RESOLVED
}

enum DocumentType {
  NOTICE
  AGREEMENT
  OTHER
}

enum ConfidenceLevel {
  LOW
  MEDIUM
  HIGH
}

enum RecoveryStrategy {
  CANCEL
  RELOCATE
  RESCHEDULE
}

enum RecoveryActionStatus {
  DRAFT
  NEEDS_CONFIRMATION
  AWAITING_APPROVAL
  APPROVED
  PROCESSING
  COMPLETED
  FAILED
  REJECTED
}

enum RecoveryActionType {
  CANCEL_COMMITMENT
  RENEGOTIATE
  RELOCATE
  RESCHEDULE
  REQUEST_REFUND
  CUSTOMER_REFUND
  ADDITIONAL_BOOKING
  OTHER
}

enum WebhookProcessingStatus {
  RECEIVED
  PROCESSING
  PROCESSED
  FAILED
  IGNORED
}

enum ActivityAction {
  PROJECT_CREATED
  PROJECT_UPDATED
  PROJECT_ARCHIVED
  SUPPLIER_CREATED
  SUPPLIER_UPDATED
  COMMITMENT_CREATED
  COMMITMENT_UPDATED
  COMMITMENT_STATUS_CHANGED
  EXPENSE_CREATED
  DISRUPTION_REPORTED
  DOCUMENT_UPLOADED
  AI_ANALYSIS_COMPLETED
  DEPENDENCY_ANALYSIS_COMPLETED
  RECOVERY_PLAN_GENERATED
  SCENARIO_CALCULATED
  ACTION_CREATED
  ACTION_APPROVED
  ACTION_REJECTED
  ACTION_STATUS_CHANGED
}

// ─────────────────────────────────────────────
// Models
// ─────────────────────────────────────────────

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  projects     Project[]
  activityLogs ActivityLog[]

  @@index([email])
}

model Project {
  id                String        @id @default(cuid())
  userId            String
  name              String
  description       String?
  eventDate         DateTime
  location          String
  /// Budget in minor units (centavos)
  budget            Int
  expectedAttendees Int
  status            ProjectStatus @default(DRAFT)
  archivedAt        DateTime?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  user              User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  suppliers         Supplier[]
  commitments       Commitment[]
  expenses          Expense[]
  customerPayments  CustomerPayment[]
  disruptions       Disruption[]
  documents         Document[]
  recoveryPlans     RecoveryPlan[]
  scenarios         Scenario[]
  recoveryActions   RecoveryAction[]
  activityLogs      ActivityLog[]

  @@index([userId])
  @@index([status])
  @@index([eventDate])
}

model Supplier {
  id            String           @id @default(cuid())
  projectId     String
  name          String
  contactPerson String?
  email         String?
  phone         String?
  category      SupplierCategory
  notes         String?
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  project     Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  commitments Commitment[]

  @@index([projectId])
  @@index([category])
  @@index([name])
}

model Commitment {
  id                     String           @id @default(cuid())
  projectId              String
  supplierId             String
  title                  String
  description            String?
  /// Agreed amount in minor units (centavos)
  agreedAmount           Int
  /// Amount already paid in minor units (centavos)
  amountPaid             Int              @default(0)
  paymentStatus          PaymentStatus    @default(UNPAID)
  serviceDate            DateTime?
  cancellationConditions String?
  refundConditions       String?
  status                 CommitmentStatus @default(DRAFT)
  createdAt              DateTime         @default(now())
  updatedAt              DateTime         @updatedAt

  project      Project                @relation(fields: [projectId], references: [id], onDelete: Cascade)
  supplier     Supplier               @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  expenses     Expense[]
  dependencies CommitmentDependency[] @relation("DependentCommitment")
  dependents   CommitmentDependency[] @relation("DependsOnCommitment")

  @@index([projectId])
  @@index([supplierId])
  @@index([status])
  @@index([paymentStatus])
  @@index([serviceDate])
}

/// A commitment may depend on another commitment, an event date, location, or service arrangement.
model CommitmentDependency {
  id                     String         @id @default(cuid())
  commitmentId           String
  dependsOnCommitmentId  String?
  dependencyType         DependencyType
  description            String
  createdAt              DateTime       @default(now())
  updatedAt              DateTime       @updatedAt

  commitment          Commitment  @relation("DependentCommitment", fields: [commitmentId], references: [id], onDelete: Cascade)
  dependsOnCommitment Commitment? @relation("DependsOnCommitment", fields: [dependsOnCommitmentId], references: [id], onDelete: SetNull)

  @@index([commitmentId])
  @@index([dependsOnCommitmentId])
  @@index([dependencyType])
}

model Expense {
  id           String          @id @default(cuid())
  projectId    String
  commitmentId String?
  description  String
  /// Amount in minor units (centavos)
  amount       Int
  category     ExpenseCategory @default(OTHER)
  incurredAt   DateTime        @default(now())
  notes        String?
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt

  project    Project     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  commitment Commitment? @relation(fields: [commitmentId], references: [id], onDelete: SetNull)

  @@index([projectId])
  @@index([commitmentId])
  @@index([category])
}

/// Reserved for Developer 2 PayPal Orders / Capture integration.
/// Seeded demo records must NOT claim real PayPal captures unless Sandbox txs exist.
model CustomerPayment {
  id              String                @id @default(cuid())
  projectId       String
  customerName    String
  customerEmail   String
  /// Amount in minor units (centavos)
  amount          Int
  currency        String                @default("PHP")
  /// Reserved for PayPal — null until Developer 2 creates Sandbox orders
  paypalOrderId   String?               @unique
  paypalCaptureId String?               @unique
  status          CustomerPaymentStatus @default(CREATED)
  capturedAt      DateTime?
  createdAt       DateTime              @default(now())
  updatedAt       DateTime              @updatedAt

  project Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  refunds Refund[]

  @@index([projectId])
  @@index([status])
  @@index([customerEmail])
}

/// Reserved for Developer 2 PayPal Refunds API.
model Refund {
  id                String       @id @default(cuid())
  customerPaymentId String
  /// Reserved for PayPal — null until Developer 2 executes refunds
  paypalRefundId    String?      @unique
  /// Amount in minor units (centavos)
  amount            Int
  reason            String?
  status            RefundStatus @default(PENDING)
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt

  customerPayment CustomerPayment @relation(fields: [customerPaymentId], references: [id], onDelete: Cascade)

  @@index([customerPaymentId])
  @@index([status])
}

model Disruption {
  id          String           @id @default(cuid())
  projectId   String
  title       String
  description String
  status      DisruptionStatus @default(REPORTED)
  reportedAt  DateTime         @default(now())
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  project        Project         @relation(fields: [projectId], references: [id], onDelete: Cascade)
  documents      Document[]
  eventAnalysis  EventAnalysis?
  recoveryPlans  RecoveryPlan[]

  @@index([projectId])
  @@index([status])
}

model Document {
  id            String       @id @default(cuid())
  projectId     String
  disruptionId  String?
  type          DocumentType
  filename      String
  mimeType      String
  /// Relative path under /uploads
  storagePath   String
  /// Extracted plain text from PDF (null if extraction pending/failed)
  extractedText String?
  uploadedAt    DateTime     @default(now())
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  project    Project     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  disruption Disruption? @relation(fields: [disruptionId], references: [id], onDelete: SetNull)

  @@index([projectId])
  @@index([disruptionId])
  @@index([type])
}

/// Structured AI output from analyzeBusinessEvent(). Validated with Zod at the service layer.
model EventAnalysis {
  id                         String          @id @default(cuid())
  disruptionId               String          @unique
  incidentType               String
  incidentSummary            String
  affectedSupplierIds        String          @default("[]") // JSON array of supplier IDs
  affectedCommitmentIds      String          @default("[]") // JSON array
  potentiallyAffectedIds     String          @default("[]") // JSON array
  unaffectedCommitmentIds    String          @default("[]") // JSON array
  relevantDates              String          @default("[]") // JSON array of ISO date strings / labels
  relevantAgreementConditions String         @default("[]") // JSON array
  evidenceReferences         String          @default("[]") // JSON array
  missingInformation         String          @default("[]") // JSON array
  assumptions                String          @default("[]") // JSON array
  confidenceLevel            ConfidenceLevel @default(MEDIUM)
  /// Full validated AI payload for audit / re-display
  rawAnalysisJson            String
  createdAt                  DateTime        @default(now())
  updatedAt                  DateTime        @updatedAt

  disruption Disruption @relation(fields: [disruptionId], references: [id], onDelete: Cascade)
}

model RecoveryPlan {
  id           String   @id @default(cuid())
  projectId    String
  disruptionId String
  /// Full validated generateRecoveryPlans() payload (3 strategies)
  plansJson    String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  project    Project    @relation(fields: [projectId], references: [id], onDelete: Cascade)
  disruption Disruption @relation(fields: [disruptionId], references: [id], onDelete: Cascade)
  scenarios  Scenario[]

  @@index([projectId])
  @@index([disruptionId])
}

model Scenario {
  id             String           @id @default(cuid())
  projectId      String
  recoveryPlanId String
  strategy       RecoveryStrategy
  summary        String
  /// User-adjustable assumptions (JSON)
  assumptionsJson String          @default("{}")
  /// Deterministic calculateScenarioFinancials() result (JSON)
  financialsJson String?
  /// Strategy detail from AI plan (JSON) — financials overwritten by simulator
  planDetailJson String
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  project         Project          @relation(fields: [projectId], references: [id], onDelete: Cascade)
  recoveryPlan    RecoveryPlan     @relation(fields: [recoveryPlanId], references: [id], onDelete: Cascade)
  recoveryActions RecoveryAction[]

  @@index([projectId])
  @@index([recoveryPlanId])
  @@index([strategy])
}

model RecoveryAction {
  id              String               @id @default(cuid())
  projectId       String
  scenarioId      String?
  type            RecoveryActionType
  title           String
  description     String?
  status          RecoveryActionStatus @default(DRAFT)
  /// Related commitment if applicable
  commitmentId    String?
  /// Amount in minor units when action involves money (estimate until confirmed)
  amount          Int?
  requiresPaypal  Boolean              @default(false)
  approvedAt      DateTime?
  rejectedAt      DateTime?
  rejectionReason String?
  completedAt     DateTime?
  failedAt        DateTime?
  failureReason   String?
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt

  project  Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  scenario Scenario? @relation(fields: [scenarioId], references: [id], onDelete: SetNull)

  @@index([projectId])
  @@index([scenarioId])
  @@index([status])
  @@index([type])
}

model ActivityLog {
  id         String         @id @default(cuid())
  projectId  String
  userId     String?
  action     ActivityAction
  entityType String
  entityId   String?
  message    String
  metadataJson String       @default("{}")
  createdAt  DateTime       @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user    User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([projectId])
  @@index([userId])
  @@index([action])
  @@index([createdAt])
}

/// Reserved for Developer 2 PayPal webhook ingestion.
model WebhookEvent {
  id               String                   @id @default(cuid())
  paypalEventId    String                   @unique
  eventType        String
  processingStatus WebhookProcessingStatus  @default(RECEIVED)
  /// Raw webhook payload for idempotent reprocessing
  payloadJson      String
  receivedAt       DateTime                 @default(now())
  processedAt      DateTime?
  errorMessage     String?
  createdAt        DateTime                 @default(now())
  updatedAt        DateTime                 @updatedAt

  @@index([eventType])
  @@index([processingStatus])
  @@index([receivedAt])
}
