  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "eslint",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:seed": "prisma db seed",
    "db:reset": "prisma migrate reset --force",
    "db:studio": "prisma studio",
    "verify:seed": "tsx scripts/verify-seed.ts",
    "verify:phase2": "tsx scripts/verify-phase2.ts",
    "verify:phase3": "tsx scripts/verify-phase3.ts",
    "verify:phase4": "tsx scripts/verify-phase4.ts",
    "verify:phase5-8": "tsx scripts/verify-phase5-8.ts",
    "test:dependency": "tsx tests/dependency-engine.test.ts",
    "test:finance": "tsx tests/finance-engine.test.ts",
